{
  "name": "teczone-crm",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @teczone/db migrate:dev",
    "db:deploy": "pnpm --filter @teczone/db migrate:deploy",
    "db:seed": "pnpm --filter @teczone/db seed",
    "build:prod": "pnpm --filter @teczone/shared build && pnpm --filter @teczone/db build && pnpm --filter @teczone/api build && pnpm --filter @teczone/web build && node scripts/prepare-standalone.js",
    "start": "node server.js"
  }
}
