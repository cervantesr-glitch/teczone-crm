# Base de datos MySQL (Hostinger)
DATABASE_URL=mysql://crm:crm@localhost:3306/teczone_crm

# Base para pruebas e2e de la API (se vacía en cada corrida)
TEST_DATABASE_URL=mysql://crm:crm@localhost:3306/teczone_crm_test

# API
API_PORT=4000
JWT_ACCESS_SECRET=cambia-esto-access
JWT_REFRESH_SECRET=cambia-esto-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
LOGIN_RATE_LIMIT=10

# Web (Next.js reenvía /api/* a la API)
API_URL=http://localhost:4000

# Usuario administrador inicial (seed)
SEED_ADMIN_EMAIL=admin@teczone.mx
SEED_ADMIN_PASSWORD=CambiaEsto123!
SEED_ADMIN_NAME=Administrador
