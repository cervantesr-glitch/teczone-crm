// Esquema de la entrega 1 (leads). BRD v1.1, secciones 7.1, 8 y 10.
// MySQL de Hostinger (compatible con MariaDB).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────── Usuarios y roles ─────────────

enum Role {
  ADMIN
  DIRECCION
  GERENTE_COMERCIAL
  EJECUTIVO_PYME
  EJECUTIVO_TECH
  PREVENTA
  CUSTOMER_SUCCESS
  COMPRAS_OPERACIONES
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  roles              UserRole[]
  refreshTokens      RefreshToken[]
  ownedLeads         Lead[]                    @relation("LeadOwner")
  createdLeads       Lead[]                    @relation("LeadCreator")
  statusChanges      LeadStatusHistory[]
  activities         Activity[]                @relation("ActivityOwner")
  auditEntries       AuditLog[]
  ownedAccounts      Account[]                 @relation("AccountOwner")
  ownedOpportunities Opportunity[]             @relation("OpportunityOwner")
  stageChanges       OpportunityStageHistory[]
  ownedQuotes        Quote[]                   @relation("QuoteOwner")
  quoteVersions      QuoteVersion[]            @relation("QuoteVersionCreator")
  approvedVersions   QuoteVersion[]            @relation("QuoteVersionApprover")
  quoteStatusChanges QuoteStatusHistory[]

  @@map("users")
}

model UserRole {
  userId String @map("user_id") @db.Char(36)
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ───────────── Catálogos ─────────────

model LeadSource {
  id     String  @id @default(uuid()) @db.Char(36)
  name   String  @unique
  active Boolean @default(true)
  leads  Lead[]

  @@map("lead_sources")
}

model DisqualificationReason {
  id     String  @id @default(uuid()) @db.Char(36)
  name   String  @unique
  active Boolean @default(true)
  leads  Lead[]

  @@map("disqualification_reasons")
}

model Tag {
  id    String    @id @default(uuid()) @db.Char(36)
  name  String    @unique
  color String?
  leads LeadTag[]

  @@map("tags")
}

// ───────────── Leads ─────────────

enum LeadStatus {
  NUEVO
  CONTACTADO
  EN_CALIFICACION
  CALIFICADO
  DESCALIFICADO
  CONVERTIDO
}

enum LeadInterestType {
  PYME
  SOLUCIONES
  POR_DEFINIR
}

enum Currency {
  MXN
  USD
}

model Lead {
  id           String           @id @default(uuid()) @db.Char(36)
  // Folio legible LD-000123, generado desde la secuencia folio_number.
  folioNumber  Int              @unique @default(autoincrement()) @map("folio_number")
  status       LeadStatus       @default(NUEVO)
  interestType LeadInterestType @default(POR_DEFINIR) @map("interest_type")
  ownerId      String?          @map("owner_id") @db.Char(36)
  sourceId     String           @map("source_id") @db.Char(36)
  receivedAt   DateTime         @default(now()) @map("received_at")

  companyName     String  @map("company_name")
  rfc             String?
  industry        String?
  companySize     String? @map("company_size")
  contactName     String  @map("contact_name")
  contactTitle    String? @map("contact_title")
  email           String?
  phone           String?
  // Últimos 10 dígitos de phone, para detectar duplicados.
  phoneNormalized String? @map("phone_normalized")
  whatsapp        String?
  city            String?
  state           String?

  need                 String?   @db.Text
  estimatedBudget      Decimal?  @map("estimated_budget") @db.Decimal(14, 2)
  currency             Currency?
  expectedPurchaseDate DateTime? @map("expected_purchase_date") @db.Date
  // Criterios de calificación (BANT u otros, D16) y puntuación 0-100.
  qualification        Json?
  score                Int?

  firstContactDueAt        DateTime? @map("first_contact_due_at")
  firstContactAt           DateTime? @map("first_contact_at")
  disqualificationReasonId String?   @map("disqualification_reason_id") @db.Char(36)
  disqualificationNotes    String?   @map("disqualification_notes") @db.Text
  convertedAt              DateTime? @map("converted_at")
  convertedAccountId       String?   @map("converted_account_id") @db.Char(36)
  convertedContactId       String?   @map("converted_contact_id") @db.Char(36)
  convertedOpportunityId   String?   @map("converted_opportunity_id") @db.Char(36)

  createdById String    @map("created_by_id") @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  owner                  User?                   @relation("LeadOwner", fields: [ownerId], references: [id])
  createdBy              User                    @relation("LeadCreator", fields: [createdById], references: [id])
  source                 LeadSource              @relation(fields: [sourceId], references: [id])
  disqualificationReason DisqualificationReason? @relation(fields: [disqualificationReasonId], references: [id])
  convertedAccount       Account?                @relation(fields: [convertedAccountId], references: [id])
  convertedContact       Contact?                @relation(fields: [convertedContactId], references: [id])
  convertedOpportunity   Opportunity?            @relation("LeadConversion", fields: [convertedOpportunityId], references: [id])
  productsOfInterest     LeadProductInterest[]
  statusHistory          LeadStatusHistory[]
  tags                   LeadTag[]

  @@index([status])
  @@index([ownerId])
  @@index([email])
  @@index([phoneNormalized])
  @@index([companyName])
  @@index([rfc])
  @@map("leads")
}

enum ProductCategory {
  HARDWARE
  SOFTWARE
  SERVICIOS
}

model LeadProductInterest {
  id          String          @id @default(uuid()) @db.Char(36)
  leadId      String          @map("lead_id") @db.Char(36)
  category    ProductCategory
  description String
  quantity    Int?
  lead        Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_products_interest")
}

model LeadStatusHistory {
  id         String      @id @default(uuid()) @db.Char(36)
  leadId     String      @map("lead_id") @db.Char(36)
  fromStatus LeadStatus? @map("from_status")
  toStatus   LeadStatus  @map("to_status")
  userId     String      @map("user_id") @db.Char(36)
  comment    String?     @db.Text
  createdAt  DateTime    @default(now()) @map("created_at")
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_status_history")
}

model LeadTag {
  leadId String @map("lead_id") @db.Char(36)
  tagId  String @map("tag_id") @db.Char(36)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@map("lead_tags")
}

// ───────────── Cuentas, contactos y oportunidades (BRD v1.1, FR-01, FR-02, FR-25) ─────────────

model Account {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String
  legalName   String?   @map("legal_name")
  rfc         String?   @unique
  industry    String?
  companySize String?   @map("company_size")
  phone       String?
  website     String?
  city        String?
  state       String?
  notes       String?   @db.Text
  ownerId     String?   @map("owner_id") @db.Char(36)
  createdById String    @map("created_by_id") @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  owner         User?         @relation("AccountOwner", fields: [ownerId], references: [id])
  contacts      Contact[]
  opportunities Opportunity[]
  leads         Lead[]

  @@index([name])
  @@map("accounts")
}

// Rol en el comité de compra (BRD FR-01).
enum DecisionRole {
  ECONOMICO
  TECNICO
  USUARIO
  OTRO
}

model Contact {
  id              String        @id @default(uuid()) @db.Char(36)
  accountId       String        @map("account_id") @db.Char(36)
  name            String
  title           String?
  email           String?
  phone           String?
  phoneNormalized String?       @map("phone_normalized")
  whatsapp        String?
  decisionRole    DecisionRole? @map("decision_role")
  isPrimary       Boolean       @default(false) @map("is_primary")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  account       Account       @relation(fields: [accountId], references: [id])
  opportunities Opportunity[]
  leads         Lead[]

  quotes Quote[]

  @@index([accountId])
  @@index([email])
  @@map("contacts")
}

enum Pipeline {
  PYME
  SOLUCIONES
}

// Etapas de ambos pipelines (BRD 2 y 7.4); cada pipeline usa su subconjunto (packages/shared).
enum OpportunityStage {
  SOLICITUD
  COSTEO_MARGEN
  COTIZACION_ENVIADA
  NEGOCIACION
  CALIFICACION
  DISCOVERY
  DEMO_POC
  PROPUESTA_SOW
  NEGOCIACION_SLA
  GANADA
  PERDIDA
}

model Opportunity {
  id                String           @id @default(uuid()) @db.Char(36)
  folioNumber       Int              @unique @default(autoincrement()) @map("folio_number")
  name              String
  pipeline          Pipeline
  stage             OpportunityStage
  accountId         String           @map("account_id") @db.Char(36)
  primaryContactId  String?          @map("primary_contact_id") @db.Char(36)
  ownerId           String           @map("owner_id") @db.Char(36)
  amount            Decimal?         @db.Decimal(14, 2)
  currency          Currency?
  probability       Int?
  expectedCloseDate DateTime?        @map("expected_close_date") @db.Date
  closedAt          DateTime?        @map("closed_at")
  lostReason        String?          @map("lost_reason") @db.Text
  createdById       String           @map("created_by_id") @db.Char(36)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  account        Account                   @relation(fields: [accountId], references: [id])
  primaryContact Contact?                  @relation(fields: [primaryContactId], references: [id])
  owner          User                      @relation("OpportunityOwner", fields: [ownerId], references: [id])
  sourceLeads    Lead[]                    @relation("LeadConversion")
  stageHistory   OpportunityStageHistory[]
  quotes         Quote[]

  @@index([pipeline, stage])
  @@index([ownerId])
  @@map("opportunities")
}

model OpportunityStageHistory {
  id            String            @id @default(uuid()) @db.Char(36)
  opportunityId String            @map("opportunity_id") @db.Char(36)
  fromStage     OpportunityStage? @map("from_stage")
  toStage       OpportunityStage  @map("to_stage")
  userId        String            @map("user_id") @db.Char(36)
  comment       String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id])

  @@index([opportunityId])
  @@map("opportunity_stage_history")
}

// ───────────── Actividades y auditoría (compartidas por todos los módulos) ─────────────

enum ActivityType {
  LLAMADA
  REUNION
  CORREO
  WHATSAPP
  NOTA
  TAREA
}

model Activity {
  id          String       @id @default(uuid()) @db.Char(36)
  type        ActivityType
  subject     String
  description String?      @db.Text
  // Fecha del evento (cuando ocurrió) vs. createdAt (cuando se capturó), FR-08.
  occurredAt  DateTime?    @map("occurred_at")
  dueAt       DateTime?    @map("due_at")
  completedAt DateTime?    @map("completed_at")
  ownerId     String       @map("owner_id") @db.Char(36)
  // Relación polimórfica: lead, account, opportunity, quote, contract.
  relatedType String       @map("related_type")
  relatedId   String       @map("related_id") @db.Char(36)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  owner       User         @relation("ActivityOwner", fields: [ownerId], references: [id])

  @@index([relatedType, relatedId])
  @@index([ownerId, dueAt])
  @@map("activities")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Char(36)
  entity    String
  entityId  String?  @map("entity_id")
  action    String
  changes   Json?
  userId    String?  @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_log")
}

// ---------- Cotizaciones (entrega 2) ----------

model Product {
  id          String          @id @default(uuid()) @db.Char(36)
  sku         String?         @unique
  name        String
  description String?         @db.Text
  category    ProductCategory
  brand       String?
  unit        String          @default("pieza")
  unitCost    Decimal         @map("unit_cost") @db.Decimal(14, 2)
  listPrice   Decimal         @map("list_price") @db.Decimal(14, 2)
  currency    Currency
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  quoteItems  QuoteItem[]

  @@index([name])
  @@map("products")
}

// Las versiones anteriores a la vigente cubren el estado "Sustituida" del BRD (sección 7.4).
enum QuoteStatus {
  BORRADOR
  PENDIENTE_APROBACION
  AUTORIZADA
  ENVIADA
  EN_NEGOCIACION
  ACEPTADA
  RECHAZADA
  VENCIDA
}

model Quote {
  id             String      @id @default(uuid()) @db.Char(36)
  folioNumber    Int         @unique @default(autoincrement()) @map("folio_number")
  opportunityId  String      @map("opportunity_id") @db.Char(36)
  contactId      String?     @map("contact_id") @db.Char(36)
  ownerId        String      @map("owner_id") @db.Char(36)
  status         QuoteStatus @default(BORRADOR)
  currentVersion Int         @default(1) @map("current_version")
  rejectedReason String?     @map("rejected_reason") @db.Text
  sentAt         DateTime?   @map("sent_at")
  closedAt       DateTime?   @map("closed_at")
  createdById    String      @map("created_by_id") @db.Char(36)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  opportunity   Opportunity          @relation(fields: [opportunityId], references: [id])
  contact       Contact?             @relation(fields: [contactId], references: [id])
  owner         User                 @relation("QuoteOwner", fields: [ownerId], references: [id])
  versions      QuoteVersion[]
  statusHistory QuoteStatusHistory[]

  @@index([opportunityId])
  @@index([ownerId, status])
  @@map("quotes")
}

// Cada versión fija partidas, TC, IVA, vigencia y términos; lo emitido no se modifica.
model QuoteVersion {
  id              String    @id @default(uuid()) @db.Char(36)
  quoteId         String    @map("quote_id") @db.Char(36)
  number          Int
  currency        Currency
  exchangeRate    Decimal   @map("exchange_rate") @db.Decimal(10, 4)
  taxRate         Decimal   @map("tax_rate") @db.Decimal(5, 2)
  validUntil      DateTime  @map("valid_until") @db.Date
  terms           String?   @db.Text
  notes           String?   @db.Text
  subtotal        Decimal   @default(0) @db.Decimal(14, 2)
  tax             Decimal   @default(0) @db.Decimal(14, 2)
  total           Decimal   @default(0) @db.Decimal(14, 2)
  totalCost       Decimal   @default(0) @map("total_cost") @db.Decimal(14, 2)
  marginPct       Decimal   @default(0) @map("margin_pct") @db.Decimal(6, 2)
  minMarginPct    Decimal   @map("min_margin_pct") @db.Decimal(5, 2)
  approvedById    String?   @map("approved_by_id") @db.Char(36)
  approvedAt      DateTime? @map("approved_at")
  approvalComment String?   @map("approval_comment") @db.Text
  issuedAt        DateTime? @map("issued_at")
  createdById     String    @map("created_by_id") @db.Char(36)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  quote      Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("QuoteVersionCreator", fields: [createdById], references: [id])
  approvedBy User?       @relation("QuoteVersionApprover", fields: [approvedById], references: [id])
  items      QuoteItem[]

  @@unique([quoteId, number])
  @@map("quote_versions")
}

model QuoteItem {
  id          String       @id @default(uuid()) @db.Char(36)
  versionId   String       @map("version_id") @db.Char(36)
  position    Int
  productId   String?      @map("product_id") @db.Char(36)
  sku         String?
  description String       @db.Text
  quantity    Decimal      @db.Decimal(12, 2)
  unitCost    Decimal      @map("unit_cost") @db.Decimal(14, 2)
  unitPrice   Decimal      @map("unit_price") @db.Decimal(14, 2)
  discountPct Decimal      @default(0) @map("discount_pct") @db.Decimal(5, 2)
  lineTotal   Decimal      @map("line_total") @db.Decimal(14, 2)
  lineCost    Decimal      @map("line_cost") @db.Decimal(14, 2)
  version     QuoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id])

  @@index([versionId, position])
  @@map("quote_items")
}

model QuoteStatusHistory {
  id            String       @id @default(uuid()) @db.Char(36)
  quoteId       String       @map("quote_id") @db.Char(36)
  fromStatus    QuoteStatus? @map("from_status")
  toStatus      QuoteStatus  @map("to_status")
  versionNumber Int          @map("version_number")
  // Nulo cuando el cambio lo hace el sistema (vencimiento).
  userId        String?      @map("user_id") @db.Char(36)
  comment       String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id])

  @@index([quoteId, createdAt])
  @@map("quote_status_history")
}

// Parámetros editables por usuarios autorizados (NFR-08). Cada versión copia los que usó.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Char(36)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
